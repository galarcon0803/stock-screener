# Copy to .env and fill in. .env is gitignored.
# In GitHub Actions these are provided as repository Secrets instead.

# --- Reddit (https://www.reddit.com/prefs/apps -> create a "script" app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockSentimentTracker/1.0 by your_reddit_username

# --- Anthropic (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=

# --- Email delivery ---
# EMAIL_PROVIDER selects the sender: "gmail" or "sendgrid".
EMAIL_PROVIDER=gmail

# Gmail SMTP (Google Account -> Security -> App Passwords)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# SendGrid (only needed if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Where the daily report is delivered (comma-separated for multiple recipients)
REPORT_EMAIL_TO=
